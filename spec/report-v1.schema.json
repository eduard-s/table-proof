{
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "description": "A box in PDF points, with a top-left origin.",
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "top": {
          "title": "Top",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "bottom": {
          "title": "Bottom",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "top",
        "x1",
        "bottom"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "uncertain"
          ],
          "title": "Severity",
          "type": "string"
        },
        "table_id": {
          "title": "Table Id",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "cell_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Id"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "expected_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Text"
        },
        "observed_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Text"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "default": "pdf_text_geometry",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "table_id",
        "page",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "TableResult": {
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "title": "Table Id",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "status": {
          "enum": [
            "no_findings",
            "review",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        },
        "checked_cells": {
          "minimum": 0,
          "title": "Checked Cells",
          "type": "integer"
        },
        "total_cells": {
          "minimum": 0,
          "title": "Total Cells",
          "type": "integer"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "table_id",
        "page",
        "status",
        "checked_cells",
        "total_cells",
        "findings"
      ],
      "title": "TableResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "engine_version": {
      "default": "0.1.0",
      "title": "Engine Version",
      "type": "string"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/TableResult"
      },
      "title": "Tables",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "status": {
      "enum": [
        "no_findings",
        "review",
        "uncertain"
      ],
      "type": "string",
      "readOnly": true
    }
  },
  "required": [
    "source_name",
    "source_sha256",
    "tables",
    "status"
  ],
  "title": "AuditReport",
  "type": "object"
}
